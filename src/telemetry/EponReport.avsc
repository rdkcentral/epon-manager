{
    "namespace": "com.comcast.kestrel.odp.event",
    "name": "EPONTelemetryDiagnostics",
    "type": "record",
    "doc": "Real time diagnostics and telemetry periodic report to assess EPON ONU link health, optical transceiver performance, and interface status",
    "fields": [
        {
            "name": "header",
            "type": {
                "namespace": "com.comcast.kestrel",
                "name": "CoreHeader",
                "type": "record",
                "doc": "Common information related to the event which MUST be included in any kestrel event.",
                "fields": [
                    {
                        "name": "timestamp",
                        "type": [
                            "null",
                            {
                                "logicalType": "timestamp-millis",
                                "type": "long"
                            }
                        ],
                        "doc": "The UTC time stamp in milliseconds since Unix epoch (January 1, 1970 midnight) when the event is generated.",
                        "default": null
                    },
                    {
                        "name": "uuid",
                        "type": [
                            "null",
                            {
                                "name": "UUID",
                                "namespace": "com.comcast.kestrel.datatype",
                                "size": 16,
                                "type": "fixed"
                            }
                        ],
                        "doc": "Unique identifier for the event used for event de-duplication and tracing.",
                        "default": null
                    },
                    {
                        "name": "source",
                        "type": [
                            "null",
                            "string"
                        ],
                        "doc": "Source of this report - generally the application or process generating the event",
                        "default": null
                    }
                ]
            }
        },
        {
            "name": "cpe_id",
            "type": {
                "namespace": "com.comcast.kestrel.odp",
                "name": "CPEIdentifier",
                "type": "record",
                "doc": "Unique identifying fields for a CPE device.",
                "fields": [
                    {
                        "name": "mac_address",
                        "type": [
                            "null",
                            {
                                "name": "MacAddress",
                                "namespace": "com.comcast.kestrel.datatype",
                                "size": 6,
                                "type": "fixed"
                            }
                        ],
                        "doc": "Canonical (Identifying) MAC address for the gateway.",
                        "default": null
                    },
                    {
                        "name": "cpe_type",
                        "type": [
                            "null",
                            "string"
                        ],
                        "doc": "Contains the cpe type e.g. Extender or Gateway",
                        "default": null
                    }
                ]
            }
        },
        {
            "name": "data",
            "type": {
                "namespace": "com.comcast.kestrel.odp",
                "name": "EPONTelemetryData",
                "type": "record",
                "doc": "Contains EPON ONU diagnostic and telemetry data collected from the HAL layer at a point in time",
                "fields": [
                    {
                        "name": "BytesSent",
                        "type": ["null", "long"],
                        "doc": "Total bytes transmitted on the EPON optical interface (TR-181: Device.Optical.Interface.{i}.Stats.BytesSent)",
                        "default": null
                    },
                    {
                        "name": "BytesReceived",
                        "type": ["null", "long"],
                        "doc": "Total bytes received on the EPON optical interface (TR-181: Device.Optical.Interface.{i}.Stats.BytesReceived)",
                        "default": null
                    },
                    {
                        "name": "PacketsSent",
                        "type": ["null", "long"],
                        "doc": "Total packets transmitted on the EPON optical interface (TR-181: Device.Optical.Interface.{i}.Stats.PacketsSent)",
                        "default": null
                    },
                    {
                        "name": "PacketsReceived",
                        "type": ["null", "long"],
                        "doc": "Total packets received on the EPON optical interface (TR-181: Device.Optical.Interface.{i}.Stats.PacketsReceived)",
                        "default": null
                    },
                    {
                        "name": "ErrorsSent",
                        "type": ["null", "long"],
                        "doc": "Total transmission errors on the EPON optical interface (TR-181: Device.Optical.Interface.{i}.Stats.ErrorsSent)",
                        "default": null
                    },
                    {
                        "name": "ErrorsReceived",
                        "type": ["null", "long"],
                        "doc": "Total reception errors on the EPON optical interface (TR-181: Device.Optical.Interface.{i}.Stats.ErrorsReceived)",
                        "default": null
                    },
                    {
                        "name": "DiscardPacketsSent",
                        "type": ["null", "long"],
                        "doc": "Packets discarded prior to transmission (TR-181: Device.Optical.Interface.{i}.Stats.DiscardPacketsSent)",
                        "default": null
                    },
                    {
                        "name": "DiscardPacketsReceived",
                        "type": ["null", "long"],
                        "doc": "Packets discarded on reception (TR-181: Device.Optical.Interface.{i}.Stats.DiscardPacketsReceived)",
                        "default": null
                    },
                    {
                        "name": "BroadcastPacketsSent",
                        "type": ["null", "long"],
                        "doc": "Broadcast packets transmitted on the EPON optical interface (EPON extension)",
                        "default": null
                    },
                    {
                        "name": "BroadcastPacketsReceived",
                        "type": ["null", "long"],
                        "doc": "Broadcast packets received on the EPON optical interface (EPON extension)",
                        "default": null
                    },
                    {
                        "name": "MulticastPacketsSent",
                        "type": ["null", "long"],
                        "doc": "Multicast packets transmitted on the EPON optical interface (EPON extension)",
                        "default": null
                    },
                    {
                        "name": "MulticastPacketsReceived",
                        "type": ["null", "long"],
                        "doc": "Multicast packets received on the EPON optical interface (EPON extension)",
                        "default": null
                    },
                    {
                        "name": "MaxBitRate",
                        "type": ["null", "int"],
                        "doc": "Maximum negotiated bit rate in Mbps (TR-181: Device.Optical.Interface.{i}.MaxBitRate). Typically 1000 for 1G-EPON or 10000 for 10G-EPON",
                        "default": null
                    },
                    {
                        "name": "FECCorrected",
                        "type": ["null", "long"],
                        "doc": "Number of FEC (Forward Error Correction) corrected bit errors on the EPON link (EPON extension)",
                        "default": null
                    },
                    {
                        "name": "FECUncorrectable",
                        "type": ["null", "long"],
                        "doc": "Number of FEC uncorrectable codewords - indicates severe signal degradation (EPON extension)",
                        "default": null
                    },
                    {
                        "name": "RangingResyncs",
                        "type": ["null", "long"],
                        "doc": "Number of MPCP ranging resynchronisations between ONU and OLT (EPON extension). Frequent resyncs may indicate distance or timing issues",
                        "default": null
                    },
                    {
                        "name": "MACResets",
                        "type": ["null", "long"],
                        "doc": "Number of MAC layer resets on the EPON interface (EPON extension). Indicates serious link-level recovery events",
                        "default": null
                    },
                    {
                        "name": "UnicastPacketsSent",
                        "type": ["null", "long"],
                        "doc": "Unicast packets transmitted on the EPON optical interface (TR-181: Device.Optical.Interface.{i}.Stats.X_RDK_UnicastPacketsSent)",
                        "default": null
                    },
                    {
                        "name": "UnicastPacketsReceived",
                        "type": ["null", "long"],
                        "doc": "Unicast packets received on the EPON optical interface (TR-181: Device.Optical.Interface.{i}.Stats.X_RDK_UnicastPacketsReceived)",
                        "default": null
                    },
                    {
                        "name": "BER",
                        "type": ["null", "string"],
                        "doc": "Calculated Bit Error Rate in scientific notation (TR-181: Device.Optical.Interface.{i}.Stats.X_RDK_BER). Example: 1.5e-09",
                        "default": null
                    },
                    {
                        "name": "TransmitOpticalLevel",
                        "type": ["null", "int"],
                        "doc": "Transmit (TX) optical power in Dbm1000 units (dBm x 1000). Typical range: -6000 to +3000. Example: -2500 = -2.5 dBm",
                        "default": null
                    },
                    {
                        "name": "OpticalSignalLevel",
                        "type": ["null", "int"],
                        "doc": "Receive (RX) optical power in Dbm1000 units (dBm x 1000). Typical range: -30000 to 0. Example: -15000 = -15.0 dBm",
                        "default": null
                    },
                    {
                        "name": "LowerOpticalThreshold",
                        "type": ["null", "int"],
                        "doc": "Lower receive optical power alarm threshold in Dbm1000 units (dBm x 1000). Example: -28000 = -28.0 dBm",
                        "default": null
                    },
                    {
                        "name": "UpperOpticalThreshold",
                        "type": ["null", "int"],
                        "doc": "Upper receive optical power alarm threshold in Dbm1000 units (dBm x 1000). Example: -8000 = -8.0 dBm",
                        "default": null
                    },
                    {
                        "name": "LowerTransmitPowerThreshold",
                        "type": ["null", "int"],
                        "doc": "Lower transmit optical power alarm threshold in Dbm1000 units (dBm x 1000). Example: -1000 = -1.0 dBm",
                        "default": null
                    },
                    {
                        "name": "UpperTransmitPowerThreshold",
                        "type": ["null", "int"],
                        "doc": "Upper transmit optical power alarm threshold in Dbm1000 units (dBm x 1000). Example: 5000 = 5.0 dBm",
                        "default": null
                    },
                    {
                        "name": "TransceiverTemperature",
                        "type": ["null", "int"],
                        "doc": "Optical transceiver module temperature in millidegrees Celsius (C x 1000). Example: 45200 = 45.2 C. High temperature may indicate hardware stress",
                        "default": null
                    },
                    {
                        "name": "SupplyVoltage",
                        "type": ["null", "int"],
                        "doc": "Optical transceiver supply voltage in millivolts (V x 1000). Typical value around 3300 mV (3.3V)",
                        "default": null
                    },
                    {
                        "name": "LaserBiasCurrent",
                        "type": ["null", "int"],
                        "doc": "Laser bias current in microamps (mA x 1000). Increasing bias current over time may indicate laser degradation. Example: 25500 = 25.5 mA",
                        "default": null
                    },
                    {
                        "name": "OperationalMode",
                        "type": ["null", "string"],
                        "doc": "EPON operational mode string, e.g. '1G-EPON' or '10G-EPON'",
                        "default": null
                    },
                    {
                        "name": "EncryptionMode",
                        "type": ["null", "int"],
                        "doc": "Current encryption mode: 0=Disabled, 1=AES-128 (IEEE 802.3ah), 2=Triple Churning, 3=AES-256",
                        "default": null
                    },
                    {
                        "name": "ONUStatus",
                        "type": ["null", "int"],
                        "doc": "Current ONU registration status: 0=LOS (no signal), 1=Downstream Signal Detected, 2=Registered, 3=Deregistering",
                        "default": null
                    }
                ]
            }
        }
    ]
}
